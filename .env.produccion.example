# Variables de Umbral en produccion.
# En Railway se escriben en la pestaña "Variables" del servicio (no se sube este archivo con datos).
# En un servidor propio: copia este archivo como ".env.produccion".
UMBRAL_MODO_DEV=0
# Genera la llave con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
UMBRAL_SECRET_KEY=
UMBRAL_URL_SITIO=https://umbral.mazariegoscarlos.com
UMBRAL_ORIGENES=https://umbral.mazariegoscarlos.com
UMBRAL_REVISION_LOCAL=0
# Correos separados por coma que veran la seccion Administracion.
UMBRAL_ADMINS=mazariegoslagunacarlosandres@gmail.com

# Base de datos. En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Si se deja vacia se usa SQLite en /datos/umbral.db.
DATABASE_URL=

# Correo por API (Railway cierra el puerto SMTP). Llave de https://resend.com
UMBRAL_RESEND_API_KEY=
UMBRAL_CORREO_REMITENTE=no-responder@mazariegoscarlos.com

# Alternativa: SMTP (solo en un servidor que permita el puerto 587)
UMBRAL_SMTP_HOST=
UMBRAL_SMTP_PORT=587
UMBRAL_SMTP_USER=
UMBRAL_SMTP_PASS=
