# Copia este archivo como ".env" (en esta misma carpeta) y ajusta lo que necesites.
# Sin archivo .env, Umbral arranca en modo desarrollo y funciona en tu equipo.

# 1 = desarrollo (tu computadora).  0 = publicado en internet con HTTPS.
UMBRAL_MODO_DEV=1

# Llave para firmar las sesiones. En desarrollo se genera sola.
# Para publicar, crea una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
UMBRAL_SECRET_KEY=

# Direccion del sitio. Es la que aparece en los enlaces de los correos.
UMBRAL_URL_SITIO=http://localhost:8000
UMBRAL_ORIGENES=http://localhost:8000,http://localhost:5173

# ---- Correo ----
# Vacio = los correos se muestran en la consola del servidor (para probar).
# Con Gmail: activa la verificacion en 2 pasos y crea una "contraseña de aplicacion"
# en https://myaccount.google.com/apppasswords  (16 letras, va en UMBRAL_SMTP_PASS).
UMBRAL_SMTP_HOST=
UMBRAL_SMTP_PORT=587
UMBRAL_SMTP_USER=
UMBRAL_SMTP_PASS=
UMBRAL_CORREO_REMITENTE=

# 1 = la API puede revisar la computadora donde corre (util en tu equipo).
# En un servidor publico dejalo en 0: ahi se usa el agente.
UMBRAL_REVISION_LOCAL=1

# Correos (separados por coma) que veran la seccion "Administración".
UMBRAL_ADMINS=

# Opcional: enviar correos con Resend (API) en vez de SMTP.
UMBRAL_RESEND_API_KEY=
