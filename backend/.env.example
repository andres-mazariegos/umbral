# Copia este archivo como ".env" y ajusta lo que necesites.
# Si no pones nada, Umbral funciona con valores por defecto.

# Clave para firmar los tokens (cambiala por una secreta).
UMBRAL_SECRET_KEY=cambia-esta-clave-en-produccion

# Base de datos (por defecto SQLite en un archivo local).
UMBRAL_DATABASE_URL=sqlite:///./umbral.db

# Modo desarrollo: 1 = al registrarte te devuelve el codigo para probar
# sin tener correo configurado. En produccion ponlo en 0.
UMBRAL_MODO_DEV=1

# Correo (opcional). Si lo llenas, el codigo se envia de verdad.
# Ejemplo con Gmail: usa una "contraseña de aplicacion", no tu contraseña normal.
UMBRAL_SMTP_HOST=
UMBRAL_SMTP_PORT=587
UMBRAL_SMTP_USER=
UMBRAL_SMTP_PASS=
